{
  "name": "@dhd/shell",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial local-first, plugin-friendly Cursor-style workbench for DeepSeek Harness",
  "author": "DeepSeek Harness Desktop contributors",
  "homepage": "https://github.com/davidtan2008/deepseek-harness-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidtan2008/deepseek-harness-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/davidtan2008/deepseek-harness-desktop/issues"
  },
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node ./scripts/build.mjs && node ../../scripts/generate-runtime-manifest.mjs source && node ./scripts/wait-and-launch.mjs",
    "start": "electron ./dist/main.js",
    "pack:app": "node ../../scripts/generate-runtime-manifest.mjs packaged && electron-builder --config ../../electron-builder.yml",
    "pack:mac": "node ../../scripts/generate-runtime-manifest.mjs packaged && electron-builder --mac --config ../../electron-builder.yml",
    "pack:win": "node ../../scripts/generate-runtime-manifest.mjs packaged && electron-builder --win --config ../../electron-builder.yml",
    "pack:linux": "node ../../scripts/generate-runtime-manifest.mjs packaged && electron-builder --linux --config ../../electron-builder.yml"
  },
  "dependencies": {
    "@dhd/shared": "workspace:*",
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "electron": "^36.9.2",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
