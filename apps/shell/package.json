{
  "name": "@dhd/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node ./scripts/build.mjs && node ./scripts/wait-and-launch.mjs",
    "start": "electron ./dist/main.js",
    "pack:app": "electron-builder --config ../../electron-builder.yml",
    "pack:mac": "electron-builder --mac --config ../../electron-builder.yml",
    "pack:win": "electron-builder --win --config ../../electron-builder.yml",
    "pack:linux": "electron-builder --linux --config ../../electron-builder.yml"
  },
  "dependencies": {
    "@dhd/shared": "workspace:*",
    "chokidar": "^4.0.3",
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "electron": "^36.9.2",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
